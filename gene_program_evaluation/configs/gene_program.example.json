{
  "global": {
    "path_mode": "shared_pseudo_pairing_pipeline",
    "pairing_root": "${PAIRING_ROOT:-../work/pairing}",
    "evaluation_root": "${EVALUATION_ROOT:-../work/evaluation}",
    "processed_data_root": "${PROCESSED_DATA_ROOT:-../work/processed}",
    "dataset_ids": [
      "Replogle_RPE"
    ],
    "manifest_dataset_names": {
      "Replogle_RPE": "Replogle_rpe_data"
    },
    "perturbed_groups": [
      "single"
    ],
    "use_generation_run_config": true,
    "use_manifest_pseudo_files": true,
    "use_selected_variants": false,
